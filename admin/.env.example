# Public identifiers (safe in a browser). Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEVER put a service-role / secret key in this app or in any NEXT_PUBLIC_ variable.
# The export script (scripts/export-approved.ts) reads SUPABASE_SERVICE_ROLE_KEY from
# the environment of the machine that runs it (CI secret), not from a file.
